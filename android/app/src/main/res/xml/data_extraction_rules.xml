<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
        Android 12+ replacement for full-backup-content. Same intent as
        backup_rules.xml: keep wallet secrets local. Excludes every
        domain so no app data ever participates in device transfer or
        cloud backup.
    -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
