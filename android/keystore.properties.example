# Copy to `keystore.properties` (gitignored) and fill in your
# release keystore credentials before running `./gradlew
# assembleRelease` locally. Without this file the release build
# silently falls back to the debug keystore — convenient for a
# developer smoke test, but the resulting APK will be rejected by
# the Play Store.
#
# Path resolution:
#   - `storeFile` is resolved relative to the Android project root
#     (`android/`). Use an absolute path if you keep the keystore
#     outside the repo.
#   - All passwords must be non-blank; any blank field disables
#     the release config and forces a fallback to debug.
#
# Generating a fresh keystore (one-off):
#   keytool -genkey -v \
#     -keystore android/yubtc-release.keystore \
#     -alias yubtc \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# CI:
#   The `apk` job in `.github/workflows/release.yml` reads the
#   `YBTC_KEYSTORE_PROPERTIES` repository secret (base64-encoded
#   contents of this file) and decodes it into
#   `android/keystore.properties` before invoking gradle.
storeFile=yubtc-release.keystore
storePassword=replace-me
keyAlias=replace-me
keyPassword=replace-me
